{
  "name": "ffmpeg-media-skill",
  "version": "1.0.0",
  "description": "FFmpeg 多媒体处理标准化技能模块",
  "author": "Antigravity Team",
  "defaults": {
    "video_codec": "libx264",
    "preset": "medium",
    "crf": 23,
    "audio_codec": "mp3",
    "gif_fps": 12,
    "gif_width": 480
  },
  "supported_operations": [
    "convert",
    "extract_audio",
    "resize",
    "clip",
    "create_gif",
    "merge",
    "batch_process"
  ],
  "supported_video_extensions": [
    ".mp4", ".avi", ".mov", ".mkv", ".flv", ".wmv", ".webm"
  ],
  "supported_audio_extensions": [
    ".mp3", ".aac", ".wav", ".flac", ".m4a", ".ogg"
  ]
}
